{
  "name": "dsh-memory-cloud-brain",
  "version": "0.1.0",
  "description": "Brain-like layered long-term memory for DeepSeek Harness that doubles as the context compaction engine",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WenXin-L/dsh-memory-cloud.git"
  },
  "homepage": "https://github.com/WenXin-L/dsh-memory-cloud#readme",
  "bugs": {
    "url": "https://github.com/WenXin-L/dsh-memory-cloud/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./engine": "./lib/engine.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/engine.js",
    "lib/*.js.map",
    "locale/*.json",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.en.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "memory",
    "long-term-memory",
    "compaction",
    "context-compaction",
    "companion"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0-0",
    "node": ">=24.9"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "tsdown"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "~1.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-app-boot": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-commands": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-compaction": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-config-editor": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-home-paths": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-session-log-deepseek": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-token-meter": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": true
    },
    "@deepseek-ai/dsh-app-boot": {
      "optional": true
    },
    "@deepseek-ai/dsh-config-editor": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-log-deepseek": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "~1.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.5",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.5",
    "@deepseek-ai/dsh-atomic-write": "0.2.2-rc.5",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.5",
    "@deepseek-ai/dsh-compaction": "0.2.2-rc.5",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-rc.5",
    "@deepseek-ai/dsh-config-editor": "0.2.2-rc.5",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-log-deepseek": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "@deepseek-ai/dsh-token-meter": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
